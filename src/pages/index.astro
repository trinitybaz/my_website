---
const name = "Trinity";
const interests = ["software", "music", "food"];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{name}</title>
  </head>

  <body>
    <main>
      <h1>{name}</h1>

      <p>
        Software engineer, musician, and generally curious person.
      </p>

      <ul>
        {interests.map((interest) => (
          <li>{interest}</li>
        ))}
      </ul>
    </main>
  </body>
</html>